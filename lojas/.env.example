# Banco PostgreSQL
# No Docker (docker-compose.yml) basta DB_SENHA; o DATABASE_URL é montado sozinho.
DB_SENHA=troque-esta-senha-do-banco
DATABASE_URL=postgres://lojas:lojas@localhost:5432/lojas_dev

# Endereço público da plataforma (usado nos links de pagamento e no webhook do Mercado Pago)
APP_URL=http://localhost:3000

# Domínio de cada loja -> slug. Sem isso, as lojas ficam em /loja/<slug>
# LOJA_DOMINIOS=infinitesemijoias.com.br=infinite,www.infinitesemijoias.com.br=infinite,bgimports.com.br=bg-imports

# Primeiro acesso ao painel (usado só pelo "npm run db:seed")
ADMIN_EMAIL=voce@exemplo.com
ADMIN_SENHA=troque-esta-senha

# Mercado Pago (opcional, um token por loja; slug em maiúsculas, hífen vira _)
# MERCADOPAGO_TOKEN_INFINITE=APP_USR-...
# MERCADOPAGO_TOKEN_BG_IMPORTS=APP_USR-...

# Mercado Livre (um app para a plataforma; cada loja conecta a própria conta no painel)
# Crie em https://developers.mercadolivre.com.br/devcenter
# ML_CLIENT_ID=
# ML_CLIENT_SECRET=

# Shopee Open Platform (precisa de aprovação da Shopee)
# SHOPEE_PARTNER_ID=
# SHOPEE_PARTNER_KEY=
# SHOPEE_AMBIENTE=producao

# Token que a Kira (n8n) usa para consultar /api/kira/*
# KIRA_API_TOKEN=gere-um-token-longo

# Pasta das fotos enviadas pelo painel
UPLOAD_DIR=./uploads
