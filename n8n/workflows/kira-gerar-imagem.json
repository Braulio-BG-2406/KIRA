    {
      "id": "969a47d5-b362-41b9-bd79-5db6fa704555",
      "name": "Gerar imagem (Gemini)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [
        660,
