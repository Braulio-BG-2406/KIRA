    {
      "id": "04cc9b5d-1133-4e28-bcb3-7634813485ee",
      "name": "Preparar pedido",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        300
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "// Prepara o pedido de imagem ao Gemini: confere a descrição, escolhe o formato e o modelo.\n// Modelos de imagem do Gemini (\"Nano Banana\"): o principal e um reserva, usado se o principal falhar.\nconst MODELO_PRINCIPAL = 'gemini-3.1-flash-image';\nconst MODELO_RESERVA = 'gemini-2.5-flash-image';\n\nconst FORMATOS = {\n  quadrado: '1:1', quadrada: '1:1', feed: '1:1',\n  retrato: '4:5', vertical: '4:5',\n  story: '9:16', stories: '9:16', reels: '9:16',\n  paisagem: '16:9', horizontal: '16:9', banner: '16:9', widescreen: '16:9',\n};\nconst PROPORCOES = ['1:1', '2:3', '3:2', '3:4', '4:3', '4:5', '5:4', '9:16', '16:9', '21:9'];\n\nconst entrada = $input.first().json;\nconst descricao = String(entrada.descricao ?? '').trim();\nif (!descricao) throw new Error('Faltou a descrição da imagem.');\n\nconst pedido = String(entrada.formato ?? '').trim().toLowerCase();\nconst formato = PROPORCOES.includes(pedido) ? pedido : FORMATOS[pedido] ?? '1:1';\nconst modelo = String(entrada.modelo ?? '').trim().replace(/^models\\//, '') || MODELO_PRINCIPAL;\nconst corpo = {\n  contents: [{ role: 'user', parts: [{ text: descricao }] }],\n  generationConfig: { responseModalities: ['TEXT', 'IMAGE'], imageConfig: { aspectRatio: formato } },\n};\n\nreturn [\n  {\n    json: {\n      descricao,\n      legenda: String(entrada.legenda ?? '').trim().slice(0, 900),\n      formato,\n      chat_id: String(entrada.chat_id ?? '').trim(),\n      user_id: String(entrada.user_id ?? '').trim(),\n      modelo,\n      modelo_reserva: modelo === MODELO_RESERVA ? MODELO_PRINCIPAL : MODELO_RESERVA,\n      corpo: JSON.stringify(corpo),\n    },\n  },\n];\n"
      }
    },
