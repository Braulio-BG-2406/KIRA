    {
      "id": "f3f0ad22-53d3-475f-a62c-9cee7548e46f",
      "name": "Validar pedido",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        300
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "// Confere o pedido do vídeo vitrine: de 1 a 3 fotos (números da Foto #N ou Imagem #N), a música e a duração.\nconst MAX_FOTOS = 3;\nconst e = $input.first().json;\nconst texto = (v) => String(v ?? '').trim();\nconst fotos = [...new Set((texto(e.fotos).match(/\\d+/g) || []).map(Number).filter((n) => n > 0))];\nconst duracao = Math.min(20, Math.max(6, Math.round(Number(e.duracao) || 10)));\nconst pedido = {\n  user_id: texto(e.user_id),\n  chat_id: texto(e.chat_id),\n  fotos,\n  musica: Math.max(0, Math.floor(Number(e.musica) || 0)),\n  duracao,\n};\nlet mensagem = '';\nif (!pedido.user_id || !pedido.chat_id) mensagem = 'Não consegui identificar o dono.';\nelse if (!fotos.length) mensagem = 'Diga quais fotos usar (o número da Foto #N ou da Imagem #N), de 1 a 3.';\nelse if (fotos.length > MAX_FOTOS) mensagem = `O vídeo vitrine usa no máximo ${MAX_FOTOS} fotos. Escolha até ${MAX_FOTOS}.`;\nreturn [{ json: { ...pedido, ok: !mensagem, mensagem } }];\n"
      }
    },
