    {
      "id": "07017b99-014c-4f9f-a192-c0cf5ac723a4",
      "name": "Montar formulário",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1760,
        200
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "// Junta as fotos e a música baixadas do Telegram num formulário multipart (foto1, foto2, foto3, musica) para o\n// serviço de vídeo da VPS. Cada arquivo baixado chega na mesma ordem dos pedidos do \"Separar arquivos\"; se algum\n// não baixou, para tudo e diz qual, para o vídeo não sair com a foto errada.\n// O formulário vai como arquivo comum (application/octet-stream): marcado como multipart/form-data, o nó HTTP do\n// n8n tenta remontá-lo byte a byte e trava o n8n. O serviço acha a fronteira na primeira linha.\nconst itens = $input.all();\nconst campos = $('Separar arquivos').all().map((i) => i.json);\nconst nomes = { foto1: 'a 1ª foto', foto2: 'a 2ª foto', foto3: 'a 3ª foto', musica: 'a música' };\nconst fronteira = 'kira' + Date.now().toString(36) + Math.random().toString(36).slice(2, 10);\nconst partes = [];\nfor (let i = 0; i < campos.length; i++) {\n  const campo = campos[i].campo;\n  if (!itens[i]?.binary?.data) throw new Error(`Não consegui baixar ${nomes[campo] || campo} do Telegram`);\n  const dados = await this.helpers.getBinaryDataBuffer(i, 'data');\n  const tipo = itens[i].binary.data.mimeType || 'application/octet-stream';\n  partes.push(Buffer.from(`--${fronteira}\\r\\nContent-Disposition: form-data; name=\"${campo}\"; filename=\"${campo}\"\\r\\nContent-Type: ${tipo}\\r\\n\\r\\n`));\n  partes.push(dados);\n  partes.push(Buffer.from('\\r\\n'));\n}\npartes.push(Buffer.from(`--${fronteira}--\\r\\n`));\nconst corpo = Buffer.concat(partes);\nconst { campo, file_id, ...pedido } = campos[0];\nreturn [\n  {\n    json: pedido,\n    binary: { data: { data: corpo.toString('base64'), mimeType: 'application/octet-stream', fileName: 'formulario.bin' } },\n  },\n];\n"
      },
      "onError": "continueErrorOutput"
    },
