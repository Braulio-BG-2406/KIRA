    {
      "id": "5d315a82-de4c-4e94-ae88-36ea1cd1ddb2",
      "name": "Separar arquivos",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1100,
        200
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "// Escolhe os arquivos do vídeo: as fotos pedidas (só as do próprio dono, na ordem pedida) e a música (a pedida\n// ou, se veio 0, a última que ele mandou). Devolve um item por arquivo, com o campo do formulário.\nconst pedido = $('Validar pedido').first().json;\nconst imagens = $('Buscar fotos').all().map((i) => i.json).filter((r) => r && r.id);\nconst musicas = $('Buscar músicas').all().map((i) => i.json).filter((r) => r && r.id && r.file_id);\nconst porId = new Map(imagens.map((r) => [Number(r.id), r]));\nconst faltando = pedido.fotos.filter((n) => !String(porId.get(n)?.file_id ?? '').trim());\nif (faltando.length) {\n  return [{ json: { ok: false, mensagem: `Não encontrei a foto #${faltando.join(', #')} (ou ela não chegou a ser guardada). Confira o número.` } }];\n}\nlet musica = null;\nif (pedido.musica) {\n  musica = musicas.find((m) => Number(m.id) === pedido.musica) || null;\n  if (!musica) return [{ json: { ok: false, mensagem: `Não encontrei a música #${pedido.musica}. Ele pode mandar o arquivo de áudio com a legenda \"música\".` } }];\n} else if (musicas.length) {\n  musica = musicas.reduce((a, b) => (Number(b.id) > Number(a.id) ? b : a));\n}\nif (musica && Number(musica.tamanho) > 20 * 1024 * 1024) {\n  return [{ json: { ok: false, mensagem: `A música #${musica.id} passa de 20 MB e o robô do Telegram não consegue baixar. Peça um arquivo menor.` } }];\n}\nconst comum = { ok: true, fotos: pedido.fotos, musica_id: musica ? Number(musica.id) : 0, musica_titulo: musica?.titulo ?? '', duracao: pedido.duracao };\nconst itens = pedido.fotos.map((n, i) => ({ json: { ...comum, campo: `foto${i + 1}`, file_id: porId.get(n).file_id } }));\nif (musica) itens.push({ json: { ...comum, campo: 'musica', file_id: musica.file_id } });\nreturn itens;\n"
      }
    },
